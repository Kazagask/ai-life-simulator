{
  "name": "ai-life-simulator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @life-sim/server --filter @life-sim/web dev",
    "start": "pnpm --filter @life-sim/server start",
    "build": "pnpm typecheck && pnpm --filter @life-sim/web build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "inspect": "pnpm --filter @life-sim/server run inspect",
    "test": "vitest run",
    "build:admin": "esbuild apps/admin/battle.tsx --bundle --format=esm --jsx=automatic --outfile=apps/admin/battle.js --alias:react=./node_modules/react/index.js --alias:react/jsx-runtime=./node_modules/react/jsx-runtime.js --alias:react-dom=./node_modules/react-dom/index.js --alias:react-dom/client=./node_modules/react-dom/client.js --alias:@life-sim/shared=./packages/shared/src/index.ts --alias:@life-sim/rpg-ui=./packages/rpg-ui/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.8.0"
  }
}
