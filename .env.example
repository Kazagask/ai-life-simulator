# 服务端口（发布沙箱会注入 PORT）
PORT=3000

# 本地管理端开关：1 = /admin 开门（不设防，仅限本机）
# LIFE_SIM_ADMIN=1

# 线上管理端口令：配了就开门，但 /admin 与 /api/admin/* 都要带 ?token=<值>
# 第一次带 token 打开后会种 HttpOnly cookie，页面里的子资源就不用再塞口令。
# LIFE_SIM_ADMIN_TOKEN=

# 存档目录（默认 <repo>/data/worlds，JSON 文件存储，不依赖任何数据库）
# LIFE_SIM_DATA_DIR=./data/worlds

# 模板目录（默认 <repo>/specs/data/templates）
# TEMPLATES_DIR=./specs/data/templates
